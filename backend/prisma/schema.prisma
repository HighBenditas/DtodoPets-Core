generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles                 Role[]
  users                 User[]
  locations             Location[]
  warehouses            Warehouse[]
  brands                Brand[]
  categories            Category[]
  products              Product[]
  variants              ProductVariant[]
  inventoryBalances     InventoryBalance[]
  inventoryMovements    InventoryMovement[]
  inventoryReservations InventoryReservation[]
  customers             Customer[]
  customerAddresses     CustomerAddress[]
  orders                Order[]
  orderItems            OrderItem[]
  orderStatusHistory    OrderStatusHistory[]
  payments              Payment[]
  paymentRefunds        PaymentRefund[]
  orderReturns          OrderReturn[]
  orderReturnItems      OrderReturnItem[]
  shipments             Shipment[]
  shipmentItems         ShipmentItem[]
  shipmentStatusHistory ShipmentStatusHistory[]
}

model Brand {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  slug           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products     Product[]

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
  @@index([organizationId, active])
}

model Category {
  id             String   @id @default(uuid())
  organizationId String
  parentId       String?
  name           String
  slug           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent       Category?    @relation("CategoryTree", fields: [parentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  children     Category[]   @relation("CategoryTree")
  products     Product[]

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
  @@index([organizationId, active])
  @@index([parentId])
}

model Product {
  id             String   @id @default(uuid())
  organizationId String
  brandId        String?
  categoryId     String?
  name           String
  slug           String
  description    String?
  species        String?
  lifeStage      String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand        Brand?           @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)
  category     Category?        @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: Restrict)
  images       ProductImage[]
  variants     ProductVariant[]

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
  @@index([organizationId, active])
  @@index([brandId])
  @@index([categoryId])
}

model ProductVariant {
  id              String   @id @default(uuid())
  organizationId  String
  productId       String
  sku             String
  name            String?
  format          String?
  weightGrams     Int?
  barcode         String?
  costAmount      Decimal  @db.Decimal(14, 0)
  priceAmount     Decimal  @db.Decimal(14, 0)
  salePriceAmount Decimal? @db.Decimal(14, 0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product           Product            @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)
  inventoryBalances InventoryBalance[]
  orderItems        OrderItem[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@unique([id, organizationId])
  @@index([organizationId, active])
  @@index([productId])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, url])
  @@index([productId, sortOrder])
}

enum InventoryMovementType {
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  RESERVATION
  RELEASE
  COMMIT
  RETURN
}

enum InventoryReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

model InventoryBalance {
  id               String   @id @default(uuid())
  organizationId   String
  warehouseId      String
  variantId        String
  physicalQuantity Int      @default(0)
  reservedQuantity Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouse    Warehouse              @relation(fields: [warehouseId, organizationId], references: [id, organizationId], onDelete: Restrict)
  variant      ProductVariant         @relation(fields: [variantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  movements    InventoryMovement[]
  reservations InventoryReservation[]

  @@unique([organizationId, warehouseId, variantId])
  @@unique([id, organizationId])
  @@index([organizationId, updatedAt])
  @@index([warehouseId])
  @@index([variantId])
}

model InventoryMovement {
  id             String                @id @default(uuid())
  organizationId String
  balanceId      String
  operationId    String
  type           InventoryMovementType
  physicalDelta  Int                   @default(0)
  reservedDelta  Int                   @default(0)
  physicalBefore Int
  physicalAfter  Int
  reservedBefore Int
  reservedAfter  Int
  reason         String
  referenceType  String?
  referenceId    String?
  actorUserId    String
  createdAt      DateTime              @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  balance      InventoryBalance @relation(fields: [balanceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  actor        User             @relation("InventoryMovementActor", fields: [actorUserId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([balanceId, createdAt])
  @@index([organizationId, operationId])
  @@index([organizationId, referenceType, referenceId])
}

model InventoryReservation {
  id               String                     @id @default(uuid())
  organizationId   String
  balanceId        String
  quantity         Int
  status           InventoryReservationStatus @default(ACTIVE)
  reason           String
  referenceType    String?
  referenceId      String?
  createdByUserId  String
  releasedByUserId String?
  releaseReason    String?
  createdAt        DateTime                   @default(now())
  releasedAt       DateTime?
  consumedByUserId String?
  consumeReason    String?
  consumedAt       DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  balance      InventoryBalance @relation(fields: [balanceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy    User             @relation("InventoryReservationCreator", fields: [createdByUserId, organizationId], references: [id, organizationId], onDelete: Restrict)
  releasedBy   User?            @relation("InventoryReservationReleaser", fields: [releasedByUserId, organizationId], references: [id, organizationId], onDelete: Restrict)
  consumedBy   User?            @relation("InventoryReservationConsumer", fields: [consumedByUserId, organizationId], references: [id, organizationId], onDelete: Restrict)
  orderItem    OrderItem?

  @@unique([organizationId, referenceType, referenceId, balanceId])
  @@unique([id, organizationId])
  @@index([organizationId, status, createdAt])
  @@index([balanceId, status])
}

model Customer {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  rut            String?
  notes          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  addresses    CustomerAddress[]
  orders       Order[]

  @@unique([organizationId, email])
  @@unique([organizationId, phone])
  @@unique([organizationId, rut])
  @@unique([id, organizationId])
  @@index([organizationId, active, name])
}

model CustomerAddress {
  id             String   @id @default(uuid())
  organizationId String
  customerId     String
  label          String
  recipientName  String
  phone          String?
  addressLine1   String
  addressLine2   String?
  commune        String
  city           String
  region         String
  postalCode     String?
  instructions   String?
  isDefault      Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  orders       Order[]

  @@unique([customerId, label])
  @@unique([id, organizationId])
  @@index([organizationId, active])
  @@index([customerId, active, isDefault])
}

model Location {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  addressLine1   String?
  addressLine2   String?
  commune        String?
  city           String?
  region         String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouses   Warehouse[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@index([organizationId, active])
}

model Warehouse {
  id             String   @id @default(uuid())
  organizationId String
  locationId     String?
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location          Location?          @relation(fields: [locationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  inventoryBalances InventoryBalance[]
  orders            Order[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@index([organizationId, active])
  @@index([locationId])
}

model User {
  id             String   @id @default(uuid())
  organizationId String
  email          String
  passwordHash   String
  firstName      String
  lastName       String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization                  Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roles                         UserRole[]
  sessions                      AuthSession[]
  inventoryMovements            InventoryMovement[]     @relation("InventoryMovementActor")
  createdInventoryReservations  InventoryReservation[]  @relation("InventoryReservationCreator")
  releasedInventoryReservations InventoryReservation[]  @relation("InventoryReservationReleaser")
  consumedInventoryReservations InventoryReservation[]  @relation("InventoryReservationConsumer")
  createdOrders                 Order[]                 @relation("OrderCreator")
  orderStatusChanges            OrderStatusHistory[]    @relation("OrderStatusActor")
  createdPayments               Payment[]               @relation("PaymentCreator")
  createdPaymentRefunds         PaymentRefund[]         @relation("PaymentRefundCreator")
  createdOrderReturns           OrderReturn[]           @relation("OrderReturnCreator")
  createdShipments              Shipment[]              @relation("ShipmentCreator")
  shipmentStatusChanges         ShipmentStatusHistory[] @relation("ShipmentStatusActor")

  @@unique([organizationId, email])
  @@unique([id, organizationId])
  @@index([organizationId, active])
}

model Role {
  id             String   @id @default(uuid())
  organizationId String
  key            String
  name           String
  description    String?
  system         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions  RolePermission[]
  users        UserRole[]

  @@unique([organizationId, key])
  @@index([organizationId])
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Order {
  id                String      @id @default(uuid())
  organizationId    String
  number            String
  customerId        String
  customerAddressId String
  warehouseId       String
  status            OrderStatus @default(PENDING)
  currency          String      @default("CLP")
  subtotalAmount    Decimal     @db.Decimal(14, 0)
  discountAmount    Decimal     @default(0) @db.Decimal(14, 0)
  shippingAmount    Decimal     @default(0) @db.Decimal(14, 0)
  totalAmount       Decimal     @db.Decimal(14, 0)
  customerSnapshot  Json
  shippingSnapshot  Json
  notes             String?
  createdByUserId   String
  confirmedAt       DateTime?
  cancelledAt       DateTime?
  completedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer        Customer             @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  customerAddress CustomerAddress      @relation(fields: [customerAddressId, organizationId], references: [id, organizationId], onDelete: Restrict)
  warehouse       Warehouse            @relation(fields: [warehouseId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy       User                 @relation("OrderCreator", fields: [createdByUserId, organizationId], references: [id, organizationId], onDelete: Restrict)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  payments        Payment[]
  returns         OrderReturn[]
  shipments       Shipment[]

  @@unique([organizationId, number])
  @@unique([id, organizationId])
  @@index([organizationId, status, createdAt])
  @@index([customerId, createdAt])
  @@index([warehouseId, createdAt])
}

model OrderItem {
  id                     String   @id @default(uuid())
  organizationId         String
  orderId                String
  variantId              String
  inventoryReservationId String?
  skuSnapshot            String
  nameSnapshot           String
  unitPriceAmount        Decimal  @db.Decimal(14, 0)
  quantity               Int
  subtotalAmount         Decimal  @db.Decimal(14, 0)
  discountAmount         Decimal  @default(0) @db.Decimal(14, 0)
  totalAmount            Decimal  @db.Decimal(14, 0)
  createdAt              DateTime @default(now())

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order                Order                 @relation(fields: [orderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  variant              ProductVariant        @relation(fields: [variantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  inventoryReservation InventoryReservation? @relation(fields: [inventoryReservationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  returnItems          OrderReturnItem[]
  shipmentItems        ShipmentItem[]

  @@unique([id, organizationId])
  @@unique([orderId, variantId])
  @@unique([inventoryReservationId, organizationId])
  @@index([organizationId, createdAt])
  @@index([variantId])
}

model OrderStatusHistory {
  id             String      @id @default(uuid())
  organizationId String
  orderId        String
  status         OrderStatus
  reason         String
  actorUserId    String
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order        Order        @relation(fields: [orderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  actor        User         @relation("OrderStatusActor", fields: [actorUserId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([orderId, createdAt])
}

enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  BANK_TRANSFER
  STORE_CREDIT
  OTHER
}

enum PaymentStatus {
  CAPTURED
  PARTIALLY_REFUNDED
  REFUNDED
}

model Payment {
  id                String        @id @default(uuid())
  organizationId    String
  orderId           String
  method            PaymentMethod
  status            PaymentStatus @default(CAPTURED)
  currency          String        @default("CLP")
  amount            Decimal       @db.Decimal(14, 0)
  provider          String
  externalReference String?
  idempotencyKey    String
  requestHash       String
  notes             String?
  createdByUserId   String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order        Order           @relation(fields: [orderId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy    User            @relation("PaymentCreator", fields: [createdByUserId, organizationId], references: [id, organizationId], onDelete: Restrict)
  refunds      PaymentRefund[]

  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, provider, externalReference])
  @@unique([id, organizationId])
  @@index([organizationId, status, createdAt])
  @@index([orderId, createdAt])
}

model PaymentRefund {
  id                String   @id @default(uuid())
  organizationId    String
  paymentId         String
  currency          String   @default("CLP")
  amount            Decimal  @db.Decimal(14, 0)
  reason            String
  externalReference String?
  idempotencyKey    String
  requestHash       String
  createdByUserId   String
  createdAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payment      Payment      @relation(fields: [paymentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy    User         @relation("PaymentRefundCreator", fields: [createdByUserId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@unique([paymentId, externalReference])
  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@index([paymentId, createdAt])
}

model OrderReturn {
  id              String   @id @default(uuid())
  organizationId  String
  orderId         String
  number          String
  reason          String
  idempotencyKey  String
  requestHash     String
  createdByUserId String
  createdAt       DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order        Order             @relation(fields: [orderId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy    User              @relation("OrderReturnCreator", fields: [createdByUserId, organizationId], references: [id, organizationId], onDelete: Restrict)
  items        OrderReturnItem[]

  @@unique([organizationId, number])
  @@unique([organizationId, idempotencyKey])
  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@index([orderId, createdAt])
}

model OrderReturnItem {
  id             String   @id @default(uuid())
  organizationId String
  orderReturnId  String
  orderItemId    String
  quantity       Int
  restocked      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orderReturn  OrderReturn  @relation(fields: [orderReturnId, organizationId], references: [id, organizationId], onDelete: Cascade)
  orderItem    OrderItem    @relation(fields: [orderItemId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([orderReturnId, orderItemId])
  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@index([orderItemId, createdAt])
}

enum ShipmentType {
  PICKUP
  OWN_DELIVERY
  MARKETPLACE
  EXTERNAL_COURIER
}

enum ShipmentStatus {
  PENDING
  READY
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model Shipment {
  id                   String         @id @default(uuid())
  organizationId       String
  orderId              String
  number               String
  type                 ShipmentType
  status               ShipmentStatus @default(PENDING)
  currency             String         @default("CLP")
  customerChargeAmount Decimal        @default(0) @db.Decimal(14, 0)
  actualCostAmount     Decimal?       @db.Decimal(14, 0)
  carrier              String?
  serviceName          String?
  trackingNumber       String?
  trackingUrl          String?
  notes                String?
  idempotencyKey       String
  requestHash          String
  createdByUserId      String
  readyAt              DateTime?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order         Order                   @relation(fields: [orderId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy     User                    @relation("ShipmentCreator", fields: [createdByUserId, organizationId], references: [id, organizationId], onDelete: Restrict)
  items         ShipmentItem[]
  statusHistory ShipmentStatusHistory[]

  @@unique([organizationId, number])
  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, carrier, trackingNumber])
  @@unique([id, organizationId])
  @@index([organizationId, status, createdAt])
  @@index([orderId, createdAt])
}

model ShipmentItem {
  id             String   @id @default(uuid())
  organizationId String
  shipmentId     String
  orderItemId    String
  quantity       Int
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shipment     Shipment     @relation(fields: [shipmentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  orderItem    OrderItem    @relation(fields: [orderItemId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([shipmentId, orderItemId])
  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@index([orderItemId, createdAt])
}

model ShipmentStatusHistory {
  id               String         @id @default(uuid())
  organizationId   String
  shipmentId       String
  status           ShipmentStatus
  reason           String
  carrier          String?
  trackingNumber   String?
  trackingUrl      String?
  actualCostAmount Decimal?       @db.Decimal(14, 0)
  actorUserId      String
  createdAt        DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shipment     Shipment     @relation(fields: [shipmentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  actor        User         @relation("ShipmentStatusActor", fields: [actorUserId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([shipmentId, createdAt])
}
